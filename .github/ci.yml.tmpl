{# Rendered into .github/workflows/ci.yml by `bit sync-ci`. #}
# Generated by `{{ command }}`. Do not edit.
name: CI

on:
  push:
{% if default_branch %}
    branches: [{{ default_branch | tojson }}]
{% endif %}
  pull_request:

permissions:
  contents: read

# Only master saves. It restores only caches from the current ISO week, so
# entries that tools never trim are dropped by a cold build once a week. Other
# refs restore the newest master cache from any week.
env:
  CACHE_PATHS: |
    ~/.cache/bit
    ~/.cache/go-build
    ~/go/pkg/mod
    ~/.cache/tsk

jobs:
{% for job in jobs %}
  {{ job.id }}:
    name: {{ job.name | tojson }}
    runs-on: ubuntu-latest
    steps:
{% raw %}
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # ratchet:actions/checkout@v7
      - id: week
        run: echo "week=$(date -u +%G-W%V)" >> "$GITHUB_OUTPUT"
      - uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # ratchet:actions/cache/restore@v6
        with:
          path: ${{ env.CACHE_PATHS }}
          key: ${{ runner.os }}-${{ github.job }}-${{ steps.week.outputs.week }}-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: ${{ runner.os }}-${{ github.job }}-${{ github.ref == 'refs/heads/master' && steps.week.outputs.week || '' }}
      - uses: cashapp/activate-hermit@cea9af7913204a965fd488637a8d1811bba2e616 # ratchet:cashapp/activate-hermit@v1
{% endraw %}
      - run: {{ job.command | tojson }}
{% raw %}
      - if: github.ref == 'refs/heads/master'
        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # ratchet:actions/cache/save@v6
        with:
          path: ${{ env.CACHE_PATHS }}
          key: ${{ runner.os }}-${{ github.job }}-${{ steps.week.outputs.week }}-${{ github.run_id }}-${{ github.run_attempt }}
{% endraw %}
{% endfor %}
  # The ruleset requires only this check, so it stays valid when the jobs
  # change. always() matters: GitHub counts a skipped required check as passing.
  ci:
    name: "ci"
    if: always()
    needs: [{% for job in jobs %}{{ job.id | tojson }}{% if not loop.last %}, {% endif %}{% endfor %}]
    runs-on: ubuntu-latest
    steps:
{% raw %}
      - if: contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') || contains(needs.*.result, 'skipped')
        run: exit 1
{% endraw %}
