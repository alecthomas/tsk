# Build file for github.com/alecthomas/tsk

# The TypeScript shim is a separate module, so Go tools skip it from the root.
let go-module = [".", "internal/typescript"]
let root = project_dir()

# Files within a Go module that its checks depend on.
let go-inputs = ["**/*.go", "go.mod", "go.sum"]

# Analyzers report a compile error once per dependent package, so compile first.
build-go[go-module] = go.build {
  package = "./..."
  dir = go-module
}

test-go[go-module](package = "./...", run = ".") = go.test {
  package = package
  dir = go-module
  flags = ["-timeout=30s", "-run=#{run}"]
}

# Modernise code with the analyzers that ship with go fix.
fix-go[go-module] = exec {
  command = "go fix ./..."
  dir = go-module
  inputs = prefix(go-inputs, "#{go-module}/")
}
# Formatting after fixing keeps the two from rewriting the same files at once.
fmt-go[go-module] = go.fmt {
  package = "./..."
  dir = go-module
  depends_on = [fix-go]
}
fmt-check-go[go-module] = go.fmt-l {
  package = "./..."
  dir = go-module
}

# Lint this repository with its own linters, which .tsk/config.toml imports
# from linters/ in the same commit.
lint-tsk[go-module] = exec.test {
  command = "#{root}/#{tsk-bin.path} ./..."
  dir = go-module
  inputs = prefix(go-inputs, "#{go-module}/") + ["**/*.go", "linters/**/*.ts", ".tsk/config.toml", "internal/hostapi/*", "internal/bindings/dts/*.d.ts"]
  depends_on = [build-go, tsk-bin]
}

# Formatting also sorts imports, which Biome counts as an assist, not a lint.
fmt-ts = exec {
  command = "biome check --write --linter-enabled=false"
  inputs = ["biome.json", "linters/*.ts", "internal/hostapi/*.ts", "internal/hostapi/*.js"]
}
lint-ts = exec.test {
  command = "biome check"
  inputs = ["biome.json", "linters/*.ts", "internal/hostapi/*.ts", "internal/hostapi/*.js"]
}

fmt-action-pins = exec {
  command = "ratchet pin .github/workflows/*.yml"
  inputs = [".github/workflows/*.yml", "bin/.ratchet-0.12.0.pkg"]
}
lint-actions = exec.test {
  command = "actionlint"
  inputs = [".github/workflows/*.yml", "bin/.actionlint-1.7.12.pkg"]
}
lint-action-pins = exec.test {
  command = "ratchet lint .github/workflows/*.yml"
  inputs = [".github/workflows/*.yml", "bin/.ratchet-0.12.0.pkg"]
}
lint-release = exec.test {
  command = "goreleaser check"
  inputs = [".goreleaser.yaml", "bin/.goreleaser-2.18.2.pkg"]
}

# Regenerate the script bindings for the exposed Go packages.
gen = exec {
  command = "tsk-gen --output internal/bindings"
  inputs = ["internal/bindgen/*.go", "cmd/tsk-gen/*.go", "internal/naming/*.go", "go.mod", "go.sum"]
  outputs = ["internal/bindings/registry_gen.go", "internal/bindings/dts/*.d.ts"]
}

# Tag HEAD with the next version and push the tag, which triggers a release.
# Resolving to HEAD reruns it only once there are new commits.
explicit bump = exec {
  command = <<-EOL
    set -eu
    # Only release commits that have landed, so every tag is reachable from master.
    git fetch --quiet origin master
    if ! git merge-base --is-ancestor HEAD origin/master; then
      echo "::error::HEAD is not on origin/master"
      exit 1
    fi
    current="$(svu current)"
    # .svu.yml keeps breaking changes to a minor bump while the major is 0.
    next="$(svu next)"
    if [ "$next" = "$current" ]; then
      echo "::info::Nothing to release since $current"
      exit 0
    fi
    git tag --annotate "$next" --message "Release $next"
    # A tag left behind by a failed push would block the retry.
    git push origin "$next" || { git tag --delete "$next"; exit 1; }
    echo "::success::Released $next"
  EOL
  resolve = "git rev-parse HEAD"
}

# Test this repository's linter library the way any library tests itself.
# analyzers is a space-separated list of analyzers to test instead of all.
test-linters(analyzers = "") = exec.test {
  command = "#{root}/#{tsk-bin.path} test --dir linters --json #{analyzers}"
  results = <<-EOF
    if .event then {suite: .analyzer, event: .event} + (if .duration then {duration: .duration} else {} end)
    else {name: .case, suite: .analyzer, status: (if .passed then "pass" else "fail" end), duration: .duration, output: ((.failures // []) | join("\n"))}
    end
  EOF
  inputs = ["linters/**", "internal/hostapi/*", "internal/bindings/dts/*.d.ts"]
  depends_on = [tsk-bin]
}

explicit tsk-bin = go.exe {
  package = "./cmd/tsk"
  output = "dist/devel/tsk"
  flags = ["-ldflags", "-s -w -buildid="]
}

# Run all tests
target test = [test-go, test-linters]

# Lint everything
target lint = [lint-tsk, fmt-check-go, lint-ts, lint-actions, lint-action-pins, lint-release]

# Format everything
target fmt = [fix-go, fmt-go, fmt-ts, fmt-action-pins]

# Build tsk
target build = [tsk-bin]

target default = [test, lint]
