{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["linters/*.ts", "internal/hostapi/*.ts", "internal/hostapi/*.js"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 160
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off"
      }
    }
  }
}
