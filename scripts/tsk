#!/bin/bash
set -euo pipefail

root="$(dirname "$(readlink -f "$0")")/.."
dest="${root}/dist/devel"
name="$(basename "$0")"
src="./cmd/${name}"
mkdir -p "$dest"

build="$(mktemp "${dest}/.${name}.XXXXXX")"
trap 'rm -f "$build"' EXIT
# Publish with an atomic rename so concurrent launches only expose complete binaries.
"${root}/bin/go" build -C "${root}/${src}" -ldflags="-s -w -buildid=" -o "$build" .
mv -f "$build" "$dest/${name}"
trap - EXIT
exec "$dest/${name}" "$@"
